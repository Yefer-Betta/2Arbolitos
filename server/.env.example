# Servidor
PORT=3002
NODE_ENV=development
# false: sin proxy delante (dev con Vite). 1 si usas nginx u otro proxy.
TRUST_PROXY=false

# Base de datos MySQL
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/2arbolitos?schema=public"

# JWT (minimo 32 caracteres; en produccion el servidor no arranca con el valor de ejemplo)
JWT_SECRET=tu_secreto_jwt_aqui_muy_seguro_cambialo
JWT_EXPIRES_IN=7d

# Frontend (para CORS)
FRONTEND_URL=http://localhost:5173
